{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run format)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run test)"
    ],
    "deny": ["Read(./.env)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/formatear.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
